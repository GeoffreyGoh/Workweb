# Copy to .env and adjust. Never commit the real .env.

# Local dev: SQLite, nothing to install.
DATABASE_URL=sqlite:///./q2o.db

# Production: DigitalOcean Managed MySQL.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:25060/q2o?charset=utf8mb4

# Sign your own key in production:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me-in-production

# 8 hours - covers a working day without re-login.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Only needed if the frontend is served from a different host than the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
